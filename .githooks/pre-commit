#!/bin/bash
# Format staged Java files before commit using google-java-format (AOSP style).
# Requires: $HOME/.githooks/google-java-format.jar
# Download:  https://github.com/google/google-java-format/releases/latest
#
# Set up once per clone via preflight-check: it runs
#   git config core.hooksPath .githooks

JAR="$HOME/.githooks/google-java-format.jar"

find_java21() {
    is_java21() {
        local v
        v=$("$1" -version 2>&1 | awk -F'"' '/version/{print $2}' | cut -d. -f1)
        [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 21 ))
    }

    if [[ -n "$JAVA_HOME" && -x "$JAVA_HOME/bin/java" ]]; then
        is_java21 "$JAVA_HOME/bin/java" && echo "$JAVA_HOME/bin/java" && return
    fi
    if command -v java &>/dev/null; then
        is_java21 "$(command -v java)" && echo "$(command -v java)" && return
    fi
    local dir
    for dir in \
            "/c/Program Files/Eclipse Adoptium" \
            "/c/Program Files/Java" \
            "/c/Program Files/Microsoft" \
            "/c/Program Files/BellSoft" \
            "$HOME/.jdks"; do
        [[ -d "$dir" ]] || continue
        local java_bin
        for java_bin in "$dir"/jdk-2[1-9]*/bin/java "$dir"/jdk-2[1-9]*/bin/java.exe; do
            [[ -x "$java_bin" ]] && is_java21 "$java_bin" && echo "$java_bin" && return
        done
    done
    if [[ -x /usr/libexec/java_home ]]; then
        local jhome
        jhome=$(/usr/libexec/java_home -v 21 2>/dev/null) && echo "$jhome/bin/java" && return
    fi
    for java_bin in /usr/lib/jvm/java-2[1-9]-*/bin/java /usr/lib/jvm/temurin-2[1-9]-*/bin/java; do
        [[ -x "$java_bin" ]] && is_java21 "$java_bin" && echo "$java_bin" && return
    done
    return 1
}

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)
[[ -z "$STAGED" ]] && exit 0

if [[ ! -f "$JAR" ]]; then
    echo "  [WARN] google-java-format.jar not found at $JAR — skipping Java format"
    echo "         Download: https://github.com/google/google-java-format/releases/latest"
    exit 0
fi

JAVA=$(find_java21) || JAVA=java

while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    "$JAVA" -jar "$JAR" --aosp --replace "$file"
    git add "$file"
done <<< "$STAGED"
